# ==============================================================================
# MINDCARE NER — Environment Variables Template
# Copy this file to .env and configure values before starting services
# NEVER COMMIT THE ACTUAL .env FILE
# ==============================================================================

# General
ENVIRONMENT=development
PROJECT_NAME="MINDCARE NER"

# Database Configuration (PostgreSQL in Docker Compose)
POSTGRES_USER=mindcare_user
POSTGRES_PASSWORD=mindcare_secure_dev_password
POSTGRES_DB=mindcare_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Authentication & JWT
# Generate a secure 32+ character key for production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=replace_this_with_a_long_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Alibaba OpenCodeReview Configuration (Stored in GitHub Secrets as OCR_*)
# OCR_LLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OCR_LLM_TOKEN=your_model_api_token
# OCR_LLM_MODEL=qwen2.5-coder-32b-instruct
# OCR_USE_ANTHROPIC=false
